{
  "name": "agenticseo",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "SEO research and site audits for your coding agent: 10 agent skills and a local CLI for keyword research, competitors, backlinks, local SEO and rank tracking.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kid7st/agenticseo.git"
  },
  "engines": {
    "node": ">=24.14"
  },
  "bin": {
    "agenticseo": "./dist/src/cli.js"
  },
  "files": [
