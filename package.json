    "test": "node --import tsx --test test/*.test.ts",
    "check": "npm run build && npm test"
  },
  "dependencies": {
    "fast-xml-parser": "^5.11.1",
    "htmlparser2": "^10.1.0",
    "remeda": "^2.50.0",
    "robots-parser": "^3.0.1",
    "tldts": "^7.4.14",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^24.10.3",
    "tsx": "^4.22.4",
    "typescript": "^7.0.2"
  }
